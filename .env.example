# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://alzara:alzara_password@localhost:5432/alzara_db?schema=public"

# Authentication & Session Security (Minimum 32 characters in production)
JWT_SECRET="alzara_production_ready_jwt_secret_must_be_at_least_32_chars"
SESSION_SECRET="alzara_production_ready_session_secret_32_chars_minimum"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service Providers (Zero-cost local implementations by default)
STORAGE_PROVIDER="local"
PAYMENT_PROVIDER="mock"
EMAIL_PROVIDER="mock"
MOCK_PAYMENT_ENABLED="true"

# Environment
NODE_ENV="development"
